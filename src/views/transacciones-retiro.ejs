<section class="form-container animated fadeIn" role="form" aria-label="Formulario de retiro bancario">
  <h2 class="form-title">Realizar Retiro</h2>

  <form action="/transacciones/cuenta/<%= cuentaId %>/retiro" method="POST" class="form-content">
    <div class="form-group">
      <label for="amount">Monto:</label>
      <input type="number" id="amount" name="amount" step="0.01" class="input-field" required>
    </div>

    <button type="submit" class="submit-button">Retirar</button>
  </form>

  <div class="acciones-cuentas">
    <a href="/transacciones/cuenta/<%= cuentaId %>" class="btn-principal">← Volver a movimientos</a>
  </div>
</section>
