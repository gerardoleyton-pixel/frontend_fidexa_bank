<section class="contenedor">
  <div class="caja-texto animated fadeIn" role="form" aria-label="Formulario de inicio de sesión">
    <h2>Inicio de Sesión</h2>

    <% if (flash && flash.type && flash.message) { %>
      <div class="alert-<%= flash.type %>"><%= flash.message %></div>
    <% } else if (typeof error !== 'undefined') { %>
      <div class="alert-error"><%= error %></div>
    <% } %>

    <form action="/clientes/login" method="POST" class="form-content">
      <div class="form-group">
        <label for="email">Correo electrónico:</label>
        <input type="email" id="email" name="email" class="input-field" required autocomplete="email">
      </div>

      <div class="form-group">
        <label for="password">Contraseña:</label>
        <input type="password" id="password" name="password" class="input-field" required autocomplete="current-password">
      </div>

      <div class="form-buttons">
        <button type="submit" class="btn-principal">Ingresar</button>
      </div>
    </form>
  </div>
</section>
