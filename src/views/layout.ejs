<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Fidexa Bank</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Fidexa Bank ofrece soluciones bancarias digitales seguros, elegantes e innovadoras.">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/animations.css">
  <link rel="icon" type="image/png" href="/images/favicon.png">
</head>
<body>
  <header role="banner">
    <div class="encabezado">
      <div class="bloque-logo">
        <img src="/images/logo.png" alt="Logo de Fidexa Bank" class="logo">
      </div>

      <div class="bloque-titulo">
        <h1>Fidexa Bank</h1>
        <p class="lead">“Tu confianza, nuestra innovación.”</p>
      </div>

      <nav class="bloque-nav" role="navigation" aria-label="Navegación principal">
          <button onclick="window.location.href='/'" title="Inicio">🏠</button>
          <% if (!locals.user) { %>
            <button onclick="window.location.href='/clientes/registro'" title="Registro">Registro</button>
            <button onclick="window.location.href='/clientes/login'" title="Iniciar sesión">Iniciar sesión</button>
          <% } else { %>
            <span class="nav-user">Bienvenido, <strong><%= locals.user.fullName || locals.user.username %></strong></span>
            <button onclick="window.location.href='/cuentas'" title="Mis cuentas">Cuentas</button>
            <form action="/clientes/logout" method="POST" style="display:inline">
              <button type="submit" class="btn-link">Cerrar sesión</button>
            </form>
          <% } %>
      </nav>

    </div>
  </header>

  <main class="contenedor" role="main">
    <%- body %>
  </main>

  <footer role="contentinfo">
    <p>&copy; 2025 Fidexa Bank</p>
  </footer>

  <script>
    function pausarAnimacion() {
      const slider = document.getElementById("slider");
      if (slider) slider.classList.add("paused");
    }

    function reanudarAnimacion() {
      const slider = document.getElementById("slider");
      if (slider) slider.classList.remove("paused");
    }
  </script>
</body>
</html>
