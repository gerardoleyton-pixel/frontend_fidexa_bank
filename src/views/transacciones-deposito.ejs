<section class="contenedor">
  <div class="caja-texto animated fadeIn" role="form" aria-label="Formulario de depósito bancario">
    <h2 class="form-title">Realizar Depósito</h2>

    <form action="/transacciones/cuenta/<%= cuentaId %>/deposito" method="POST" class="form-content">
      <div class="form-group">
        <label for="amount">Monto:</label>
        <input type="number" id="amount" name="amount" step="0.01" class="input-field" required>
      </div>

      <div class="form-buttons">
        <button type="submit" class="btn-principal">Depositar</button>
      </div>
    </form>

    <div class="form-buttons">
      <a href="/transacciones/cuenta/<%= cuentaId %>" class="btn-principal">← Volver a movimientos</a>
    </div>
  </div>
</section>
